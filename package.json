    "eslint-plugin-oxlint": "^1.29.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.29.0",
    "prettier": "^3.7.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.47.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.3",
    "vitest-mock-extended": "^3.1.0"
